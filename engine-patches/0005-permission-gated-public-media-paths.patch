+    /**
+     * Public media is intentionally outside the per-clone private tree. A guest can only
+     * reach it when the host has the user-granted MANAGE_EXTERNAL_STORAGE app-op. Without
+     * that app-op the existing private redirect remains in force, preserving isolation.
+     *
+     * These rules must be installed before the broad /storage/emulated rule below. The
+     * native IO hook uses first-match order, so a later public rule would never be reached.
+     */
+    private void addPermissionGatedPublicMediaRules(Map<String, String> rule) {
+        if (!hasHostAllFilesAccess()) {
+            Slog.w(TAG, "Host has no All files access; keeping public media inside the virtual tree");
+            return;
+        }
 
+        String sharedRoot = new File(
+                "/storage/emulated/" + BlackBoxCore.getHostUserId()).getAbsolutePath();
+        String[] publicDirectories = new String[] {
+                Environment.DIRECTORY_MUSIC,
+                Environment.DIRECTORY_MOVIES,
+                Environment.DIRECTORY_DCIM,
+                Environment.DIRECTORY_PICTURES,
+                Environment.DIRECTORY_DOWNLOADS,
+                Environment.DIRECTORY_DOCUMENTS,
+                Environment.DIRECTORY_PODCASTS,
+                Environment.DIRECTORY_ALARMS,
+                Environment.DIRECTORY_RINGTONES,
+                Environment.DIRECTORY_NOTIFICATIONS,
+                "Audiobooks",
+                "Recordings"
+        };
+        for (String directory : publicDirectories) {
+            File publicPath = new File(sharedRoot, directory);
+            if (publicPath.isDirectory()) {
+                String path = publicPath.getAbsolutePath();
+                rule.put(path, path);
+                Slog.i(TAG, "Exposing permission-granted public media path: " + path);
+            }
+        }
+    }
+
+    private boolean hasHostAllFilesAccess() {
+        Context host = BlackBoxCore.getContext();
+        if (host == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            return true;
+        }
+        try {
+            AppOpsManager appOps = host.getSystemService(AppOpsManager.class);
+            if (appOps == null) return false;
+            int mode = appOps.unsafeCheckOpNoThrow(
+                    "android:manage_external_storage",
+                    Process.myUid(),
+                    host.getPackageName());
+            return mode == AppOpsManager.MODE_ALLOWED;
+        } catch (Throwable error) {
+            Slog.w(TAG, "Unable to verify host All files access: " + error.getMessage());
+            return false;
+        }
+    }
+
