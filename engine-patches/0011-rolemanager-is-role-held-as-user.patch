+package top.niunaijun.blackbox.fake.service;
+
+import android.os.IBinder;
+
+import java.lang.reflect.Method;
+
+import black.android.os.BRServiceManager;
+import top.niunaijun.blackbox.BlackBoxCore;
+import top.niunaijun.blackbox.fake.hook.BinderInvocationStub;
+import top.niunaijun.blackbox.fake.hook.MethodHook;
+import top.niunaijun.blackbox.fake.hook.ProxyMethod;
+import top.niunaijun.blackbox.utils.Slog;
+
+/**
+ * Role queries — "am I the default browser?" and similar (API 29+).
+ *
+ * Bcore had no hook for this service, so a guest's call went to the real RoleManagerService
+ * unchanged. The platform lets a caller ask about a package it owns and refuses otherwise:
+ *
+ *   java.lang.SecurityException: Package com.android.chrome does not belong to 10235
+ *       at android.app.role.IRoleManager$Stub$Proxy.isRoleHeldAsUser
+ *       at android.app.role.RoleManager.isRoleHeld
+ *
+ * Chrome asks this from didFinishNavigationInPrimaryMainFrame — after a page commits — and
+ * the SecurityException reaches native code, where it is fatal: "Uncaught Java exception in
+ * native code" followed by SIGTRAP. So the crash only becomes reachable once navigation
+ * actually works, which is why it surfaced after the renderer fix in patch 0010 rather than
+ * before it.
+ *
+ * Same shape and same remedy as {@link ILocaleManagerProxy} and the application-restrictions
+ * hook in {@link IUserManagerProxy}: rewrite the package argument to the host package, which
+ * the Binder calling UID genuinely owns.
+ */
+public class IRoleManagerProxy extends BinderInvocationStub {
+    public static final String TAG = "IRoleManagerProxy";
+
+    /** Context.ROLE_SERVICE, as a literal so this compiles against any platform level. */
+    private static final String SERVICE = "role";
+
+    public IRoleManagerProxy() {
+        super(BRServiceManager.get().getService(SERVICE));
+    }
+
+    @Override
+    protected Object getWho() {
+        try {
+            IBinder binder = BRServiceManager.get().getService(SERVICE);
+            if (binder == null) return null;
+            Class<?> stubClass = Class.forName("android.app.role.IRoleManager$Stub");
+            Method asInterface = stubClass.getMethod("asInterface", IBinder.class);
+            return asInterface.invoke(null, binder);
+        } catch (Exception e) {
+            Slog.d(TAG, "getWho error: " + e.getMessage());
+            return null;
+        }
+    }
+
+    @Override
+    protected void inject(Object baseInvocation, Object proxyInvocation) {
+        if (BRServiceManager.get().getService(SERVICE) != null) {
+            replaceSystemService(SERVICE);
+            Slog.d(TAG, "Hooked RoleManagerService");
+        } else {
+            Slog.d(TAG, "Skipping RoleManagerService hook (service not found)");
+        }
+    }
+
+    @Override
+    public boolean isBadEnv() {
+        return false;
+    }
+
+    /**
+     * {@code IRoleManager.isRoleHeldAsUser(String roleName, String packageName, int userId)}.
+     *
+     * Note the index: unlike the LocaleManager and UserManager hooks, the package is
+     * <b>args[1]</b> here — args[0] is the role name. Rewriting index 0 would replace the role
+     * with a package name and quietly return nonsense, so the argument is located by type
+     * rather than assumed by position.
+     *
+     * userId is untouched, so no other Android user is addressed, and the answer returned is
+     * the platform's own: whether the host holds that role. A guest cannot hold a platform
+     * role — a container app is not separately installed — so the host's answer is the only
+     * legitimate one available.
+     */
+    @ProxyMethod("isRoleHeldAsUser")
+    public static class IsRoleHeldAsUser extends MethodHook {
+        @Override
+        protected Object hook(Object who, Method method, Object[] args) throws Throwable {
+            if (args != null && args.length > 1 && args[1] instanceof String) {
+                args[1] = BlackBoxCore.getHostPkg();
+            }
+            return method.invoke(who, args);
+        }
+    }
+}
