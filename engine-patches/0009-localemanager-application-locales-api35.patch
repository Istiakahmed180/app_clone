+package top.niunaijun.blackbox.fake.service;
+
+import android.os.IBinder;
+
+import java.lang.reflect.Method;
+
+import black.android.os.BRServiceManager;
+import top.niunaijun.blackbox.BlackBoxCore;
+import top.niunaijun.blackbox.fake.hook.BinderInvocationStub;
+import top.niunaijun.blackbox.fake.hook.MethodHook;
+import top.niunaijun.blackbox.fake.hook.ProxyMethod;
+import top.niunaijun.blackbox.utils.Slog;
+
+/**
+ * Per-app locales (API 33+).
+ *
+ * Bcore had no hook for this service at all, so a guest's call went to the real
+ * LocaleManagerService unchanged. The platform rule is that a caller may read the per-app
+ * locale of a package it owns, and needs READ_APP_SPECIFIC_LOCALES for any other package.
+ * Inside a container the Binder calling UID is the host's while the package argument is the
+ * guest's, so the platform sees a caller asking about someone else's package and refuses:
+ *
+ *   java.lang.SecurityException: getApplicationLocales: Neither user 10234 nor current
+ *       process has android.permission.READ_APP_SPECIFIC_LOCALES.
+ *
+ * Chrome makes this call from an idle handler shortly after startup and the SecurityException
+ * reaches its main thread, so the crash is fatal rather than degraded.
+ *
+ * The fix is the one {@link IUserManagerProxy}'s application-restrictions hook already uses:
+ * rewrite the package argument to the host package, which the calling UID genuinely owns. The
+ * platform check still runs and passes on its own terms; nothing is spoofed and no exception
+ * is suppressed.
+ */
+public class ILocaleManagerProxy extends BinderInvocationStub {
+    public static final String TAG = "ILocaleManagerProxy";
+
+    /** Context.LOCALE_SERVICE, as a literal so this compiles against any platform level. */
+    private static final String SERVICE = "locale";
+
+    public ILocaleManagerProxy() {
+        super(BRServiceManager.get().getService(SERVICE));
+    }
+
+    @Override
+    protected Object getWho() {
+        try {
+            IBinder binder = BRServiceManager.get().getService(SERVICE);
+            if (binder == null) return null;
+            Class<?> stubClass = Class.forName("android.app.ILocaleManager$Stub");
+            Method asInterface = stubClass.getMethod("asInterface", IBinder.class);
+            return asInterface.invoke(null, binder);
+        } catch (Exception e) {
+            Slog.d(TAG, "getWho error: " + e.getMessage());
+            return null;
+        }
+    }
+
+    @Override
+    protected void inject(Object baseInvocation, Object proxyInvocation) {
+        if (BRServiceManager.get().getService(SERVICE) != null) {
+            replaceSystemService(SERVICE);
+            Slog.d(TAG, "Hooked LocaleManagerService");
+        } else {
+            Slog.d(TAG, "Skipping LocaleManagerService hook (service not found)");
+        }
+    }
+
+    @Override
+    public boolean isBadEnv() {
+        return false;
+    }
+
+    /**
+     * {@code ILocaleManager.getApplicationLocales(String packageName, int userId)}.
+     *
+     * args[0] is the package in every platform revision of this method, so rewriting index 0
+     * is correct without inspecting the rest of the signature. userId is left untouched, so
+     * no other Android user is addressed.
+     */
+    @ProxyMethod("getApplicationLocales")
+    public static class GetApplicationLocales extends MethodHook {
+        @Override
+        protected Object hook(Object who, Method method, Object[] args) throws Throwable {
+            if (args != null && args.length > 0 && args[0] instanceof String) {
+                args[0] = BlackBoxCore.getHostPkg();
+            }
+            return method.invoke(who, args);
+        }
+    }
+
+    /**
+     * The setter, for the same reason.
+     *
+     * Without it a guest that sets its own locale hits the same refusal from the write side
+     * (SET_APP_SPECIFIC_LOCALES), which would turn a fixed read path into a crash one call
+     * later. The argument list is longer and differs between platform revisions -- it grew
+     * fromDelegate and caller parameters -- but args[0] is the package throughout.
+     */
+    @ProxyMethod("setApplicationLocales")
+    public static class SetApplicationLocales extends MethodHook {
+        @Override
+        protected Object hook(Object who, Method method, Object[] args) throws Throwable {
+            if (args != null && args.length > 0 && args[0] instanceof String) {
+                args[0] = BlackBoxCore.getHostPkg();
+            }
+            return method.invoke(who, args);
+        }
+    }
+}
