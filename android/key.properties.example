# Copy to android/key.properties and fill in. That file is gitignored, as are *.keystore
# and *.jks -- keep the keystore itself outside the repository too.
#
# Create the keystore once, and never lose it: Play identifies an app by its signing key,
# and an app signed with a different key cannot update the one already published.
#
#   keytool -genkey -v -keystore ~/duplika-upload.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to the `android/` directory.

storeFile=../../duplika-upload.jks
storePassword=
keyAlias=upload
keyPassword=
