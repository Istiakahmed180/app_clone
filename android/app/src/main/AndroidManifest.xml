<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:label="Duplika"
        android:name=".DuplikaApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Target of per-clone home-screen shortcuts. Exported because the system
             launches it on the launcher's behalf; it carries no UI and only acts on a
             profile id that already exists. -->
        <activity
            android:name=".CloneLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The UMP consent SDK reads the publisher identity from here; there is no
             separate UMP id. The value comes from the `admobApplicationId` manifest
             placeholder in app/build.gradle.kts, which currently holds Google's public
             sample id. See docs/ONBOARDING.md. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobApplicationId}" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <!-- Phase 3 lets the user clone any launchable app, so the app picker has to be able
         to enumerate them. QUERY_ALL_PACKAGES is the only way to do that on Android 11+.

         This is a Play-policy-sensitive permission: a dual-app/cloning product is one of
         Google's permitted use cases, but it must be declared and justified at review.
         Duplika uses it ONLY to list launchable apps for the picker; it never
         inspects another app's private data. See docs/SECURITY.md. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Guests run inside the host process group, so when Android dozes Duplika it dozes
         every clone with it: background sync and notifications stop for apps the user
         believes are running. This permission enables the one-tap system dialog that asks
         the user to exempt Duplika.

         Play-policy-sensitive, like QUERY_ALL_PACKAGES above, and treated the same way:
         declared, never requested silently, and refusable. Android shows its own dialog,
         a denial is respected and never re-asked automatically, and the app is fully
         usable without it. BatteryOptimization falls back to the ordinary battery
         settings screen when the dialog is unavailable. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- ==========================================================================
         Permissions removed from the virtualization engine's merged manifest.

         Bcore declares ~250 distinct permissions so that guest apps can request
         almost anything. Carried wholesale that is unreviewable: a shipping
         competitor (com.multiapp.morespace.app) declares 104.

         Removed here, and only here:
           - SIGNATURE-level permissions, which a normally-installed app can never
             be granted, so declaring them achieves nothing but noise.
           - Permissions not defined on any current Android/GMS build, i.e. OEM- and
             launcher-specific ones (Samsung, Huawei, Oppo, HTC, Sony, badge providers).

         Deliberately NOT removed:
           - Every dangerous permission. PermissionBridge can only request what the
             host declares, so removing one would silently and permanently deny that
             capability to every clone.
           - Every normal permission.
           - Anything the shipping competitor still declares.

         Known trade-off: launcher unread-count badges from guest apps may stop
         working on OEM launchers that gate them behind their own permission.
         ========================================================================== -->
    <uses-permission android:name="android.hardware.usb.host" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_CACHE_FILESYSTEM" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCOUNT_MANAGER" tools:node="remove" />
    <uses-permission android:name="android.permission.BATTERY_STATS" tools:node="remove" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:node="remove" />
