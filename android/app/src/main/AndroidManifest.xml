    <uses-permission android:name="android.permission.CLEAR_APP_USER_DATA" tools:node="remove" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.DEVICE_POWER" tools:node="remove" />
    <uses-permission android:name="android.permission.GET_INTENT_SENDER_INTENT" tools:node="remove" />
    <uses-permission android:name="android.permission.HARDWARE_TEST" tools:node="remove" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" tools:node="remove" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" tools:node="remove" />
    <!--
      MANAGE_EXTERNAL_STORAGE is deliberately NOT removed. Guests run under the host's
      identity, so a cloned media or file app can only reach shared storage if Duplika
      itself holds this. Stripping it made the engine refuse with
      "All files access not granted for launching: <package>", and a cloned VLC then sat on
      "Loading..." forever with no way for the user to fix it: the permission was not even
      declared, so it could not be granted from Settings.

      It stays opt-in: this only declares it. Android grants it solely through the
      "All files access" screen in Settings, never silently, and clones that do not need it
      are unaffected. Note for release: Play requires a declared justification for this
      permission, so it must be argued in the listing (or the media-app subset used instead).
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
