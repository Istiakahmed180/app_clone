<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Google client libraries talk to Play services over the network stack. No
         account, no location, no storage permission is requested anywhere in Level 10. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 9: the gate on the cross-API discriminator (ActivityRecognition). Declared
         because a real app using that API would declare it, and because the probe records
         its grant state. Runtime permission on API 29+, so declaring it grants nothing.
         checkApiAvailability, which is the actual measurement, needs it neither declared
         nor granted. Deliberately NOT a location permission. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Android 11+ package filtering would hide these from this app even on an ordinary
         installation, so declaring them removes filtering as an explanation for any
         "not visible" result inside a guest. Ordinary declared visibility, not a bypass. -->
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.gsf" />
    </queries>

    <application
        android:label="Ladder L10 GMS"
        android:allowBackup="false"
        android:theme="@style/Level10Theme">
        <!-- P15 (Maps). A PLACEHOLDER, NOT A REAL KEY, and not registered to anybody.
             The Maps SDK refuses to initialise at all when no key meta-data is present, so
             without this the probe stops at a local manifest check and measures nothing
             about virtualization — which is exactly what the first host run showed
             (evidence/.../host-p15-maps-no-key.txt: "API key not found").

             This value does NOT bypass anything. Google's authorisation still runs and is
             still expected to FAIL, identically on host and in a guest, because the key is
             registered to no project. What it buys is the ability to measure the stages in
             between: renderer module load, resource access and MapView inflation, which are
             the parts a container can actually break. Borrowing a real key, or one
             registered to this package, would be the identity manoeuvre the phase forbids —
             and would not work anyway, since the container cannot present that identity. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyPLACEHOLDER-NOT-A-REAL-KEY-diagnostics-only" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
