<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions. UserManager.getApplicationRestrictions(ownPackage) is documented as
         callable by any app for itself, which is the whole point of the comparison: if it
         needs no permission on the host, a container-only failure is a virtualization gap
         rather than a missing declaration. -->

    <application
        android:label="Ladder UserManager Probe"
        android:allowBackup="false"
        android:theme="@style/UmProbeTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
